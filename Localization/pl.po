msgid "Meshes"
msgstr "Meshe"

#. Key: VoxelComponent:Meshes
#: Source/VOX4U/Public/VoxelComponent.h:30
msgctxt "UObjectToolTips,VoxelComponent:Meshes"
msgid "One cube mesh per colour."
