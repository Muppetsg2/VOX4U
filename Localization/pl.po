#. Key: VoxelAnimationTrack:ComponentName
#: Source/VOX4U/Public/VoxelAnimation.h:18
msgctxt "UObjectDisplayNames,VoxelAnimationTrack:ComponentName"
msgid "Component Name"
msgstr "Nazwa komponentu"

#. Key: VoxelAnimationTrack:ComponentName
#: Source/VOX4U/Public/VoxelAnimation.h:18
msgctxt "UObjectToolTips,VoxelAnimationTrack:ComponentName"
msgid "Name of the animated component of the actor. None: the root component, or the first static mesh or voxel component."
msgstr "Nazwa animowanego komponentu aktora. None: komponent główny albo pierwszy komponent mesha statycznego lub komponent voxel."

