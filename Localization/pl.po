#. Key: EVoxSceneModels.StaticMesh
#: Source/VOX4UEditor/Private/VoxImportOption.h:51
msgctxt "UObjectToolTips,EVoxSceneModels.StaticMesh"
msgid "One static mesh per model (monotone meshing): few triangles, the fastest to render."
msgstr "Jeden mesh statyczny na model (monotone meshing): mało trójkątów, najszybsze renderowanie."

#. Key: EVoxSceneModels.Voxel
#: Source/VOX4UEditor/Private/VoxImportOption.h:53
msgctxt "UObjectDisplayNames,EVoxSceneModels.Voxel"
