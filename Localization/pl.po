#. Key: VoxAssetImportData:BaseName
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:24
msgctxt "UObjectDisplayNames,VoxAssetImportData:BaseName"
msgid "Base Name"
msgstr "Nazwa bazowa"

#. Key: VoxAssetImportData:BaseName
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:24
msgctxt "UObjectToolTips,VoxAssetImportData:BaseName"
msgid "Base name the asset names were generated from; materials and textures are found again by it on reimport."
msgstr "Nazwa bazowa, z której wygenerowano nazwy assetów; po niej przy ponownym imporcie odnajdywane są materiały i tekstury."

#. Key: VoxAssetImportData:ModelIndex
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:27
msgctxt "UObjectDisplayNames,VoxAssetImportData:ModelIndex"
msgid "Model Index"
msgstr "Indeks modelu"

#. Key: VoxAssetImportData:ModelIndex
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:27
msgctxt "UObjectToolTips,VoxAssetImportData:ModelIndex"
msgid "Index of the model inside the .vox file, -1 for merged models."
msgstr "Indeks modelu w pliku .vox, -1 dla scalonych modeli."

#. Key: VoxAssetImportData:AnimationFrame
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:30
msgctxt "UObjectDisplayNames,VoxAssetImportData:AnimationFrame"
msgid "Animation Frame"
msgstr "Klatka animacji"

#. Key: VoxAssetImportData:AnimationFrame
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:30
msgctxt "UObjectToolTips,VoxAssetImportData:AnimationFrame"
msgid "Animation frame baked into this static mesh, -1 if it is not a frame of an animation."
msgstr "Klatka animacji wypieczona w tym meshu statycznym, -1 jeśli nie jest to klatka animacji."

#. Key: VoxAssetImportData:AssetsNamingConvention
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:33
msgctxt "UObjectDisplayNames,VoxAssetImportData:AssetsNamingConvention"
msgid "Naming Convention"
msgstr "Konwencja nazw"

#. Key: VoxAssetImportData:AssetsNamingConvention
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:33
msgctxt "UObjectToolTips,VoxAssetImportData:AssetsNamingConvention"
msgid "Name patterns of the created assets, set in Project Settings > Plugins > VOX4U."
msgstr "Wzorce nazw tworzonych assetów, ustawiane w Project Settings > Plugins > VOX4U."

#. Key: VoxAssetImportData:ResourcesSaveLocation
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:36
msgctxt "UObjectDisplayNames,VoxAssetImportData:ResourcesSaveLocation"
msgid "Resources Location"
msgstr "Miejsce zasobów"

#. Key: VoxAssetImportData:ResourcesSaveLocation
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:36
msgctxt "UObjectToolTips,VoxAssetImportData:ResourcesSaveLocation"
msgid "Where materials, textures and voxel cubes are saved."
msgstr "Gdzie zapisywane są materiały, tekstury i sześciany wokseli."

#. Key: VoxAssetImportData:bImportXForward
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:39
msgctxt "UObjectDisplayNames,VoxAssetImportData:bImportXForward"
msgid "Import X Forward"
msgstr "Przód wzdłuż osi X"

#. Key: VoxAssetImportData:bImportXForward
#: Source/VOX4UEditor/Private/VoxAssetImportData.h:39
msgctxt "UObjectToolTips,VoxAssetImportData:bImportXForward"
