#. Key: VoxelAnimationTrack:Transforms
#: Source/VOX4U/Public/VoxelAnimation.h:22
msgctxt "UObjectDisplayNames,VoxelAnimationTrack:Transforms"
msgid "Transforms"
msgstr "Transformacje"

#. Key: VoxelAnimationTrack:Transforms
#: Source/VOX4U/Public/VoxelAnimation.h:22
msgctxt "UObjectToolTips,VoxelAnimationTrack:Transforms"
msgid "Relative transform of the component in every frame. Empty: the transform is not animated."
msgstr "Względna transformacja komponentu w każdej klatce. Puste: transformacja nie jest animowana."

#. Key: VoxelAnimationTrack:ModelIndices
#: Source/VOX4U/Public/VoxelAnimation.h:26
msgctxt "UObjectDisplayNames,VoxelAnimationTrack:ModelIndices"
msgid "Model Indices"
msgstr "Indeksy modeli"

#. Key: VoxelAnimationTrack:ModelIndices
#: Source/VOX4U/Public/VoxelAnimation.h:26
msgctxt "UObjectToolTips,VoxelAnimationTrack:ModelIndices"
msgid "Model shown in every frame (index into Models, -1 for none). Empty: the model is not animated."
msgstr "Model wyświetlany w każdej klatce (indeks w Models, -1 oznacza brak). Puste: model nie jest animowany."

#. Key: VoxelAnimation:FirstFrame
#: Source/VOX4U/Public/VoxelAnimation.h:44
msgctxt "UObjectDisplayNames,VoxelAnimation:FirstFrame"
msgid "First Frame"
msgstr "Pierwsza klatka"

#. Key: VoxelAnimation:FirstFrame
#: Source/VOX4U/Public/VoxelAnimation.h:44
msgctxt "UObjectToolTips,VoxelAnimation:FirstFrame"
msgid "First frame of the animation range of MagicaVoxel's timeline."
msgstr "Pierwsza klatka zakresu animacji z osi czasu MagicaVoxel."

#. Key: VoxelAnimation:LastFrame
#: Source/VOX4U/Public/VoxelAnimation.h:48
msgctxt "UObjectDisplayNames,VoxelAnimation:LastFrame"
msgid "Last Frame"
msgstr "Ostatnia klatka"

#. Key: VoxelAnimation:LastFrame
#: Source/VOX4U/Public/VoxelAnimation.h:48
msgctxt "UObjectToolTips,VoxelAnimation:LastFrame"
msgid "Last frame of the animation range of MagicaVoxel's timeline."
msgstr "Ostatnia klatka zakresu animacji z osi czasu MagicaVoxel."

#. Key: VoxelAnimation:FramesPerSecond
#: Source/VOX4U/Public/VoxelAnimation.h:52
msgctxt "UObjectDisplayNames,VoxelAnimation:FramesPerSecond"
msgid "Frames Per Second"
msgstr "Klatki na sekundę"

#. Key: VoxelAnimation:FramesPerSecond
#: Source/VOX4U/Public/VoxelAnimation.h:52
msgctxt "UObjectToolTips,VoxelAnimation:FramesPerSecond"
msgid "Playback speed. MagicaVoxel does not store it in the file."
msgstr "Prędkość odtwarzania. MagicaVoxel nie zapisuje jej w pliku."

#. Key: VoxelAnimation:bInterpolate
#: Source/VOX4U/Public/VoxelAnimation.h:56
msgctxt "UObjectDisplayNames,VoxelAnimation:bInterpolate"
msgid "Interpolate"
msgstr "Interpoluj"

#. Key: VoxelAnimation:bInterpolate
#: Source/VOX4U/Public/VoxelAnimation.h:56
msgctxt "UObjectToolTips,VoxelAnimation:bInterpolate"
msgid "Interpolate the transforms between frames (translation and rotation). Off: every frame is held, as in MagicaVoxel. Models and mirroring always switch at whole frames."
msgstr "Interpoluje transformacje między klatkami (przesunięcie i obrót). Wyłączone: każda klatka jest wstrzymana, jak w MagicaVoxel. Modele i odbicia lustrzane zawsze zmieniają się w pełnych klatkach."

#. Key: VoxelAnimation:Models
#: Source/VOX4U/Public/VoxelAnimation.h:60
msgctxt "UObjectDisplayNames,VoxelAnimation:Models"
msgid "Models"
msgstr "Modele"

#. Key: VoxelAnimation:Models
#: Source/VOX4U/Public/VoxelAnimation.h:60
msgctxt "UObjectToolTips,VoxelAnimation:Models"
msgid "Models the tracks switch between: static meshes for static mesh components, voxel assets for voxel components."
msgstr "Modele, między którymi przełączają się ścieżki: meshe statyczne dla komponentów mesha statycznego, assety voxel dla komponentów voxel."

#. Key: VoxelAnimation:Tracks
#: Source/VOX4U/Public/VoxelAnimation.h:63
msgctxt "UObjectDisplayNames,VoxelAnimation:Tracks"
msgid "Tracks"
msgstr "Ścieżki"

#. Key: VoxelAnimation:Tracks
#: Source/VOX4U/Public/VoxelAnimation.h:63
msgctxt "UObjectToolTips,VoxelAnimation:Tracks"
msgid "Animated components."
msgstr "Animowane komponenty."

#. Key: VoxelAnimationComponent:Animation
#: Source/VOX4U/Public/VoxelAnimationComponent.h:35
msgctxt "UObjectDisplayNames,VoxelAnimationComponent:Animation"
msgid "Animation"
msgstr "Animacja"

#. Key: VoxelAnimationComponent:Animation
#: Source/VOX4U/Public/VoxelAnimationComponent.h:35
msgctxt "UObjectToolTips,VoxelAnimationComponent:Animation"
msgid "Animation to play."
msgstr "Animacja do odtworzenia."

#. Key: VoxelAnimationComponent:bAutoPlay
#: Source/VOX4U/Public/VoxelAnimationComponent.h:39
msgctxt "UObjectDisplayNames,VoxelAnimationComponent:bAutoPlay"
msgid "Auto Play"
msgstr "Odtwarzaj automatycznie"

#. Key: VoxelAnimationComponent:bAutoPlay
#: Source/VOX4U/Public/VoxelAnimationComponent.h:39
msgctxt "UObjectToolTips,VoxelAnimationComponent:bAutoPlay"
msgid "Start playing when the game starts."
msgstr "Rozpoczyna odtwarzanie po starcie gry."

#. Key: VoxelAnimationComponent:bLoop
#: Source/VOX4U/Public/VoxelAnimationComponent.h:43
msgctxt "UObjectDisplayNames,VoxelAnimationComponent:bLoop"
msgid "Loop"
msgstr "Zapętl"

#. Key: VoxelAnimationComponent:bLoop
#: Source/VOX4U/Public/VoxelAnimationComponent.h:43
msgctxt "UObjectToolTips,VoxelAnimationComponent:bLoop"
msgid "Start again from the first frame after the last one."
msgstr "Po ostatniej klatce zaczyna ponownie od pierwszej."

#. Key: VoxelAnimationComponent:PlayRate
#: Source/VOX4U/Public/VoxelAnimationComponent.h:47
msgctxt "UObjectDisplayNames,VoxelAnimationComponent:PlayRate"
msgid "Play Rate"
msgstr "Tempo odtwarzania"

#. Key: VoxelAnimationComponent:PlayRate
#: Source/VOX4U/Public/VoxelAnimationComponent.h:47
msgctxt "UObjectToolTips,VoxelAnimationComponent:PlayRate"
msgid "Speed multiplier of the animation's frames per second; negative values play backwards."
msgstr "Mnożnik liczby klatek na sekundę animacji; wartości ujemne odtwarzają wstecz."

#. Key: VoxelAnimationComponent:Frame
#: Source/VOX4U/Public/VoxelAnimationComponent.h:51
msgctxt "UObjectDisplayNames,VoxelAnimationComponent:Frame"
msgid "Frame"
msgstr "Klatka"

#. Key: VoxelAnimationComponent:Frame
#: Source/VOX4U/Public/VoxelAnimationComponent.h:51
msgctxt "UObjectToolTips,VoxelAnimationComponent:Frame"
msgid "Current frame (MagicaVoxel frame number). Changing it in the editor previews the frame; it can be keyed in Sequencer."
msgstr "Bieżąca klatka (numer klatki z MagicaVoxel). Zmiana w edytorze pokazuje podgląd klatki; można ją kluczować w Sequencerze."

#. Key: VoxelAnimationComponent:Play
#: Source/VOX4U/Public/VoxelAnimationComponent.h:59
msgctxt "UObjectDisplayNames,VoxelAnimationComponent:Play"
msgid "Play"
msgstr "Odtwórz"

#. Key: VoxelAnimationComponent:Play
#: Source/VOX4U/Public/VoxelAnimationComponent.h:59
msgctxt "UObjectToolTips,VoxelAnimationComponent:Play"
msgid "Plays the animation from the current frame. In the editor: previews it in the level."
msgstr "Odtwarza animację od bieżącej klatki. W edytorze: pokazuje jej podgląd na poziomie."

#. Key: VoxelAnimationComponent:Stop
#: Source/VOX4U/Public/VoxelAnimationComponent.h:63
msgctxt "UObjectDisplayNames,VoxelAnimationComponent:Stop"
msgid "Stop"
msgstr "Zatrzymaj"

#. Key: VoxelAnimationComponent:Stop
#: Source/VOX4U/Public/VoxelAnimationComponent.h:63
msgctxt "UObjectToolTips,VoxelAnimationComponent:Stop"
msgid "Stops the animation at the current frame. In the editor: ends the preview and returns to the frame it started from."
msgstr "Zatrzymuje animację na bieżącej klatce. W edytorze: kończy podgląd i wraca do klatki, od której się zaczął."

#. Key: VoxelComponent:CellBounds
#: Source/VOX4U/Public/VoxelComponent.h:24
msgctxt "UObjectDisplayNames,VoxelComponent:CellBounds"
msgid "Cell Bounds"
msgstr "Granice komórki"

