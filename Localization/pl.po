#. Key: Voxel:bXYCenter
#: Source/VOX4U/Public/Voxel.h:30
msgctxt "UObjectDisplayNames,Voxel:bXYCenter"
msgid "XY Center"
msgstr "Wyśrodkuj XY"

#. Key: Voxel:bXYCenter
#: Source/VOX4U/Public/Voxel.h:30
msgctxt "UObjectToolTips,Voxel:bXYCenter"
msgid "Center the voxels horizontally around the actor (assets without a pivot)."
msgstr "Wyśrodkowuje woksele w poziomie wokół aktora (assety bez pivota)."

#. Key: Voxel:bUsePivot
#: Source/VOX4U/Public/Voxel.h:34
msgctxt "UObjectDisplayNames,Voxel:bUsePivot"
msgid "Use Pivot"
msgstr "Użyj pivota"

#. Key: Voxel:bUsePivot
#: Source/VOX4U/Public/Voxel.h:34
msgctxt "UObjectToolTips,Voxel:bUsePivot"
msgid "Place the voxels around Pivot instead of using XY Center."
msgstr "Umieszcza woksele wokół pivota zamiast używać wyśrodkowania XY."

#. Key: Voxel:Pivot
#: Source/VOX4U/Public/Voxel.h:38
msgctxt "UObjectDisplayNames,Voxel:Pivot"
msgid "Pivot"
msgstr "Pivot"

#. Key: Voxel:Pivot
#: Source/VOX4U/Public/Voxel.h:38
msgctxt "UObjectToolTips,Voxel:Pivot"
msgid "Point of the voxel grid, in voxels from its corner, that lies at the origin of the component."
msgstr "Punkt siatki wokseli (w wokselach od jej narożnika), który leży w początku układu komponentu."

#. Key: Voxel:Meshes
#: Source/VOX4U/Public/Voxel.h:42
msgctxt "UObjectDisplayNames,Voxel:Meshes"
msgid "Meshes"
msgstr "Meshe"

#. Key: Voxel:Meshes
#: Source/VOX4U/Public/Voxel.h:42
msgctxt "UObjectToolTips,Voxel:Meshes"
msgid "One cube mesh per colour."
msgstr "Jeden mesh sześcianu na kolor."

#. Key: Voxel:Voxels
#: Source/VOX4U/Public/Voxel.h:45
msgctxt "UObjectDisplayNames,Voxel:Voxels"
msgid "Voxels"
msgstr "Woksele"

#. Key: Voxel:Voxels
#: Source/VOX4U/Public/Voxel.h:45
msgctxt "UObjectToolTips,Voxel:Voxels"
msgid "Voxel cells and the index of their mesh."
msgstr "Komórki wokseli i indeks ich mesha."

